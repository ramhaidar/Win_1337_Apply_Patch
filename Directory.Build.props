<Project>
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!--
    Static analysis / linting policy, applied to every project in the repository.

    The built-in .NET (Roslyn) analyzers run for all configurations so the same
    diagnostics appear in the IDE, in an ordinary Debug build, and in the Release
    quality build. Code style rules from .editorconfig are enforced at build time
    as well, so `dotnet build` and `dotnet format` verifier agree.

    Analyzer warnings only fail the build through the existing ReleaseBuild=true
    TreatWarningsAsErrors switch below; this block does not add new suppression
    or demotion behavior.
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ReleaseBuild)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Win_1337_Patch' and ('$(ReleaseMode)' == 'framework-dependent' or '$(ReleaseMode)' == 'self-contained')">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(ReleaseMode)' == 'framework-dependent'">false</SelfContained>
    <SelfContained Condition="'$(ReleaseMode)' == 'self-contained'">true</SelfContained>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <TargetLatestRuntimePatch>false</TargetLatestRuntimePatch>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.win-x64-$(ReleaseMode).lock.json</NuGetLockFilePath>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
